# PostgreSQL в Docker
POSTGRES_USER=equipment_user
POSTGRES_PASSWORD=changeMe123
POSTGRES_DB=equipment_monitoring

# Время хранения кэша в секундах
CACHE_TTL=60

# Настройки для запуска Python вне Docker
DATABASE_URL=postgresql+asyncpg://equipment_user:changeMe123@127.0.0.1:5432/equipment_monitoring
REDIS_URL=redis://127.0.0.1:6379/0